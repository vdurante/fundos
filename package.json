  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "prettier --check \"src/**/*.{ts,js}\" \"test/**/*.js\"",
    "compile": "tsc",
    "gs:pull": "clasp pull",
    "gs:push": "clasp push --force",
    "gs:status": "clasp status",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "gs:deploy": "node scripts/gs-deploy.js",
    "sortino": "node build/src/sortino.js",
    "sortino:dry": "node build/src/sortino.js --dry-run",
    "indices": "node build/src/indices.js",
    "test:writer": "npm run compile && node test/sheet-writer.js",
    "crawl:itau": "node src/crawlers/itau-rentabilidade.js && node src/crawlers/itau-documents.js",
    "crawl:itau-prev": "node src/crawlers/opin-pension.js --host api.itau --platform ITAU_PREV",
    "crawl:onze": "node src/crawlers/onze-funds.js",
    "universe": "npm run compile && node build/src/universe/build.js",
    "universe:dry": "npm run compile && node build/src/universe/build.js --dry-run",
    "test:universe": "npm run compile && node test/universe.js",
    "rentabilidade": "node build/src/rentabilidade.js",
    "rentabilidade:dry": "node build/src/rentabilidade.js --dry-run",
    "test:principal": "npm run compile && node test/principal-writer.js",
    "digest:fundos": "npm run compile && node test/digest-fundos.js",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"test/**/*.js\""
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/adm-zip": "^0.5.8",
