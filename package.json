    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cacache": "^21.0.1",
    "dotenv": "^18.0.3",
    "google-auth-library": "^11.1.0",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^181.0.0",
    "lodash": "^4.18.1",
    "mathjs": "^15.2.0",
    "papaparse": "^5.7.0",
